generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ======================================================
// ENUMS
// ======================================================

enum UserRole {
  RANGER
  PARK_MANAGER
  COMMUNITY_LIAISON
  RESEARCHER
  COMMUNITY_USER
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PatrolStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PatrolType {
  ROUTINE
  ANTI_POACHING
  WILDLIFE_MONITORING
  CONFLICT_RESPONSE
  SPECIAL
}

enum PatrolPriority {
  LOW
  MEDIUM
  HIGH
}

enum IncidentStatus {
  PENDING
  UNDER_REVIEW
  RESPONDING
  RESOLVED
  VERIFIED
  REJECTED
}

enum CommunityReportStatus {
  PENDING
  UNDER_REVIEW
  RESPONSE_IN_PROGRESS
  RESOLVED
  REJECTED
}

enum AlertStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum SyncStatus {
  PENDING
  SYNCED
  FAILED
}

enum EscalationStatus {
  PENDING
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

// ======================================================
// USERS & PARKS
// ======================================================

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  phone        String?
  role         UserRole
  isActive     Boolean  @default(true)
  approvalStatus ApprovalStatus @default(APPROVED)
  profileImageUrl String?
  rejectionReason String?
  reviewedAt DateTime?
  reviewedById String?

  parkId String?
  park   Park?   @relation("AssignedPark", fields: [parkId], references: [id])

  requestedParkId String?
  requestedPark Park? @relation("RequestedPark", fields: [requestedParkId], references: [id])

  assignedPatrols Patrol[] @relation("AssignedRanger")
  createdPatrols  Patrol[] @relation("CreatedByManager")

  incidents        Incident[]
  communityReports CommunityReport[]

  alertAcknowledgements AlertAcknowledgement[]
  respondedAlerts       Alert[]                @relation("AlertResponses")
  alertEscalations      AlertEscalation[]      @relation("AlertEscalations")
  forwardedReports      CommunityReport[]      @relation("ReportForwards")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parkId])
  @@index([requestedParkId])
  @@index([role])
  @@index([approvalStatus, role, createdAt])
}

model Park {
  id          String  @id @default(cuid())
  name        String
  location    String?
  description String?

  users       User[] @relation("AssignedPark")
  requestedUsers User[] @relation("RequestedPark")
  patrols     Patrol[]
  incidents   Incident[]
  riskZones   RiskZone[]
  cameraTraps CameraTrap[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ======================================================
// RANGER & PATROL MANAGEMENT
// ======================================================

model Patrol {
  id            String       @id @default(cuid())
  routeName     String
  description   String?
  scheduledDate DateTime?
  startTime     DateTime?
  endTime       DateTime?
  actualStartTime DateTime?
  actualEndTime   DateTime?
  status        PatrolStatus @default(SCHEDULED)

  patrolType   PatrolType   @default(ROUTINE)
  priority     PatrolPriority @default(MEDIUM)
  startLocation String?
  latitude      Float?
  longitude     Float?

  parkId String
  park   Park   @relation(fields: [parkId], references: [id])

  rangerId String
  ranger   User   @relation("AssignedRanger", fields: [rangerId], references: [id])

  createdById String
  createdBy   User             @relation("CreatedByManager", fields: [createdById], references: [id])
  locations   PatrolLocation[]
  waypoints   PatrolWaypoint[]
  incidents   Incident[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parkId])
  @@index([rangerId])
  @@index([status])
}

model PatrolLocation {
  id         String   @id @default(cuid())
  latitude   Float
  longitude  Float
  recordedAt DateTime @default(now())

  patrolId String
  patrol   Patrol @relation(fields: [patrolId], references: [id], onDelete: Cascade)

  @@index([patrolId])
}

enum PatrolWaypointType {
  START
  CHECKPOINT
  HIGH_RISK
  OBSERVATION
  END
}

model PatrolWaypoint {
  // Nullable additions preserve historical, unclassified waypoint rows.
  type       PatrolWaypointType?
  order      Int?
  label      String?
  id         String   @id @default(cuid())
  latitude   Float
  longitude  Float
  note       String?
  recordedAt DateTime @default(now())

  patrolId String
  patrol   Patrol @relation(fields: [patrolId], references: [id], onDelete: Cascade)

  @@index([patrolId])
  @@unique([patrolId, order])
}

// ======================================================
// REPORT FIELD INCIDENT
// ======================================================

model Incident {
  id           String @id @default(cuid())
  title        String?
  incidentType String
  description  String

  latitude       Float?
  longitude      Float?
  manualLocation String?

  status     IncidentStatus @default(PENDING)
  syncStatus SyncStatus     @default(SYNCED)

  occurredAt DateTime?
  reportedAt DateTime  @default(now())
  withdrawnAt DateTime?

  markAsDone Boolean @default(false)

  reporterId String
  reporter   User   @relation(fields: [reporterId], references: [id])

  parkId String
  park   Park   @relation(fields: [parkId], references: [id])

  patrolId String?
  patrol   Patrol? @relation(fields: [patrolId], references: [id])

  evidence IncidentEvidence[]
  escalatedAlerts AlertEscalation[]

  communityReportId String?
  communityReport   CommunityReport? @relation("IncidentCommunityReport", fields: [communityReportId], references: [id], onDelete: SetNull)
  forwardedCommunityReports CommunityReport[] @relation("ReportToIncident")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reporterId])
  @@index([parkId])
  @@index([patrolId])
  @@index([incidentType])
  @@index([status])
  @@index([markAsDone])
  @@index([communityReportId])
}

model IncidentEvidence {
  id       String  @id @default(cuid())
  fileUrl  String
  fileType String
  caption  String?
  metadata Json?

  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([incidentId])
}

// ======================================================
// COMMUNITY REPORTING
// ======================================================

model CommunityReport {
  id          String  @id @default(cuid())
  reportType  String
  species     String?
  description String

  latitude       Float?
  longitude      Float?
  manualLocation String?

  status CommunityReportStatus @default(PENDING)

  reporterName  String?
  reporterPhone String?

  isAnonymous Boolean @default(false)

  // Optional registered community user
  reporterId String?
  reporter   User?   @relation(fields: [reporterId], references: [id])

  submittedAt DateTime @default(now())

  evidence CommunityReportEvidence[]

  // Operational Incident Response handoff (Chanuka)
  incidentId      String?
  incident        Incident? @relation("ReportToIncident", fields: [incidentId], references: [id], onDelete: SetNull)
  forwardedAt     DateTime?
  forwardedById   String?
  forwardedBy     User?     @relation("ReportForwards", fields: [forwardedById], references: [id], onDelete: SetNull)
  forwardingNotes String?
  incidents       Incident[] @relation("IncidentCommunityReport")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([reporterId])
  @@index([isAnonymous])
  @@index([incidentId])
  @@index([forwardedById])
}

model CommunityReportEvidence {
  id       String @id @default(cuid())
  fileUrl  String
  fileType String

  reportId String
  report   CommunityReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([reportId])
}

// ======================================================
// WILDLIFE TRACKING / MOCK COLLAR DATA
// ======================================================

model Animal {
  id         String  @id @default(cuid())
  animalCode String  @unique
  species    String
  name       String?
  sex        String?
  notes      String?

  collar    TrackingCollar?
  locations AnimalLocation[]
  alerts    Alert[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TrackingCollar {
  id         String  @id @default(cuid())
  collarCode String  @unique
  isActive   Boolean @default(true)

  animalId String @unique
  animal   Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AnimalLocation {
  id            String   @id @default(cuid())
  latitude      Float
  longitude     Float
  recordedAt    DateTime @default(now())
  heartRate     Int?
  temperature   Float?
  activityLevel String?

  // MOCK means this can be simulated IoT collar data
  source String @default("MOCK_COLLAR")

  animalId String
  animal   Animal @relation(fields: [animalId], references: [id], onDelete: Cascade)

  @@index([animalId])
  @@index([recordedAt])
}

// ======================================================
// RISK ZONES & ALERT MANAGEMENT
// ======================================================

model RiskZone {
  id          String    @id @default(cuid())
  name        String
  description String?
  riskLevel   RiskLevel
  isActive    Boolean   @default(true)

  // For prototype: simple centre + radius representation
  centerLatitude  Float
  centerLongitude Float
  radiusMeters    Float

  parkId String
  park   Park   @relation(fields: [parkId], references: [id])

  alerts Alert[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parkId])
  @@index([riskLevel])
}

model Alert {
  id        String      @id @default(cuid())
  riskLevel RiskLevel
  message   String
  status    AlertStatus @default(ACTIVE)

  generatedAt DateTime  @default(now())
  resolvedAt  DateTime?

  // Operational liaison / authorized response
  responseNote  String?
  respondedById String?
  respondedAt   DateTime?
  responder     User?     @relation("AlertResponses", fields: [respondedById], references: [id])

  // Ranger / Manager operational handoff
  forwardedTo String?
  forwardedAt DateTime?

  animalId String
  animal   Animal @relation(fields: [animalId], references: [id])

  riskZoneId String
  riskZone   RiskZone @relation(fields: [riskZoneId], references: [id])

  acknowledgements AlertAcknowledgement[]
  escalations      AlertEscalation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([animalId])
  @@index([riskZoneId])
  @@index([status])
  @@index([respondedById])
}

model AlertAcknowledgement {
  id             String    @id @default(cuid())
  readAt         DateTime? @default(now())
  acknowledgedAt DateTime?

  alertId String
  alert   Alert  @relation(fields: [alertId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@unique([alertId, userId])
  @@index([userId])
}

model AlertEscalation {
  id               String           @id @default(cuid())
  alertId          String
  alert            Alert            @relation(fields: [alertId], references: [id], onDelete: Cascade)
  escalatedById    String
  escalator        User             @relation("AlertEscalations", fields: [escalatedById], references: [id])
  reason           String
  status           EscalationStatus @default(PENDING)
  priority         String
  targetDepartment String           @default("INCIDENT_RESPONSE")
  incidentId       String?
  incident         Incident?        @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  escalatedAt      DateTime         @default(now())
  resolvedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([alertId])
  @@index([escalatedById])
  @@index([status])
  @@index([alertId, status])
}

// ======================================================
// CAMERA TRAPS - MOCK/SIMULATED
// ======================================================

model CameraTrap {
  id         String  @id @default(cuid())
  cameraCode String  @unique
  name       String?
  latitude   Float
  longitude  Float
  isActive   Boolean @default(true)

  parkId String
  park   Park   @relation(fields: [parkId], references: [id])

  images CameraTrapImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parkId])
}

model CameraTrapImage {
  id           String   @id @default(cuid())
  imageUrl     String
  capturedAt   DateTime
  species      String?
  reviewStatus String   @default("PENDING")
  notes        String?

  // Simulated camera-trap upload
  source String @default("MOCK_CAMERA_TRAP")

  cameraTrapId String
  cameraTrap   CameraTrap @relation(fields: [cameraTrapId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([cameraTrapId])
  @@index([reviewStatus])
}
